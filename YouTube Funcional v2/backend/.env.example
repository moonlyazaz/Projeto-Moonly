# ============================================================================
# MoonTube v2 — Backend (modelo de configuração)
# ============================================================================
# Copie este arquivo para ".env" e preencha os valores reais:
#
#   cp .env.example .env        (Linux / macOS)
#   Copy-Item .env.example .env (Windows / PowerShell)
#
# NUNCA envie o arquivo ".env" real para o GitHub/remoto: ele é ignorado
# pelo .gitignore justamente para não vazar chaves secretas.
# ============================================================================

# Chave da API do YouTube (Google Cloud Console -> "APIs e Serviços" ->
# "Credenciais" -> "Chaves de API"). O backend aceita VÁRIAS chaves
# separadas por vírgula, alternando automaticamente quando uma atinge a
# cota diária gratuita. Exemplo:
#   YOUTUBE_API_KEY=chave1,chave2,chave3
YOUTUBE_API_KEY=sua_chave_aqui

# Porta em que o servidor Express/MoonTube vai escutar (opcional).
# Se omitida, o padrão usado é a 3000.
PORTA=3000

# Origens permitidas no CORS (frontend), separadas por vírgula.
# Deixe vazio para aceitar qualquer origem (útil em dev/Render).
# Ex.: CORS_ORIGINS=https://meu-frontend.com,http://localhost:5500
CORS_ORIGINS=

